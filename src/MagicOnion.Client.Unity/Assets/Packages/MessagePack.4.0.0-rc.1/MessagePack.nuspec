<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MessagePack</id>
    <version>4.0.0-rc.1</version>
    <authors>neuecc</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/MessagePack-CSharp/MessagePack-CSharp</projectUrl>
    <description>Extremely fast MessagePack (MsgPack) serializer for C#: source-generated formatters, Native AOT and trimming support, zero-copy buffers on .NET 9+, and wire compatibility with MessagePack for C# v3. Supports .NET Framework (netstandard2.0), .NET 9+ and Unity.</description>
    <copyright>© Yoshifumi Kawai and contributors. All rights reserved.</copyright>
    <tags>MsgPack MessagePack Serialization Formatter Serializer Unity</tags>
    <repository type="git" url="https://github.com/MessagePack-CSharp/MessagePack-CSharp" branch="refs/heads/v4" commit="3f58b5a96f6700c7c753bd511ec3547c919d9acd" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="SerializerFoundation" version="1.4.1" include="All" />
      </group>
      <group targetFramework="net11.0">
        <dependency id="SerializerFoundation" version="1.4.1" include="All" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="SerializerFoundation" version="1.4.1" include="All" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="SerializerFoundation" version="1.4.1" include="All" />
        <dependency id="System.Collections.Immutable" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="System.IO.Pipelines" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="6.1.2" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="SerializerFoundation" version="1.4.1" include="All" />
        <dependency id="System.Collections.Immutable" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="System.IO.Pipelines" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="6.1.2" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="8.0.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>